JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_TOKEN=your_jira_api_token

OPENAI_API_KEY=your_openai_api_key
MODEL=gpt-5

ANTHROPIC_API_KEY=
CLAUDE_MODEL=

ISSUE_KEYS=Story-XXXX, Story-XXXX

# Bật để chạy browser có UI (dễ debug flow capture)
CAPTURE_HEADFUL=0

APP_URL=https://stage.a2zflow.ai
APP_USERNAME=your_username
APP_PASSWORD=your_password

# Tuỳ chọn: override đường dẫn e2e project và auth state
# E2E_PROJECT_ROOT=/path/to/e2e
# E2E_AUTH_FILE=/path/to/playwright/.auth/user.json
